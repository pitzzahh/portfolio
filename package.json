{
	"name": "portfolio",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"gen": "wrangler types && grep -v 'mainModule: typeof import(\"./.svelte-kit/cloudflare/_worker\")' worker-configuration.d.ts > worker-configuration.d.ts.tmp && mv worker-configuration.d.ts.tmp worker-configuration.d.ts",
		"test:unit": "vitest",
		"test": "pnpm run test:unit -- --run"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@ethercorps/sveltekit-og": "^4.3.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26",
		"@vitest/browser-playwright": "^5.0.3",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"playwright": "^1.63.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.3.2",
		"vitest": "^5.0.3",
		"vitest-browser-svelte": "^3.1.0",
		"wrangler": "^4.147.0"
	},
	"dependencies": {
		"lenis": "^1.3.26"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"packageManager": "pnpm@12.9.1"
}
